# Backend (FastAPI). Copy to backend/.env — never commit the real file.

ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me

# Firebase service account (Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

CORS_ORIGINS=http://localhost:3000

# AI providers — server-wide fallback keys (a key on a node / in Credentials wins)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Self-hosted model via Ollama (docker compose sets this to http://ollama:11434/v1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Self-hosting: hostnames/IPs the API may be reached by ("*" = any). Default: localhost + the hosted domains.
# ALLOWED_HOSTS=*
# Self-hosting: allow tool/AI servers on this machine or LAN (blocked by default on shared hosting)
# ALLOW_PRIVATE_HOSTS=true
# Which AI builds workflows from a description: auto | local | openai | groq | gemini | custom
# ASSISTANT_PROVIDER=local
# MCP (tool servers): local "command" servers run programs on this machine, so they are off by default
# MCP_ALLOW_STDIO=true

# Comma-separated platform admin emails (in addition to role=admin in Firestore)
ADMIN_EMAILS=admin@gmail.com

LOG_LEVEL=INFO
